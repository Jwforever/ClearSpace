<Window x:Class="ClearSpace.App.ResidueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载完成 · 清理残留" Width="900" Height="570" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/assets/ClearSpace.ico"
        FocusManager.FocusedElement="{Binding ElementName=DismissButton}">
  <Border Background="#F7F8F5"><Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#6D8071" Margin="0,9,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
      <Grid>
        <DataGrid x:Name="ResidueList" ItemsSource="{Binding Candidates}" IsReadOnly="True" CanUserSortColumns="False" RowHeight="NaN" MinRowHeight="70" AutomationProperties.Name="卸载残留清单">
          <DataGrid.Columns>
            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="96" />
            <DataGridTemplateColumn Header="完整位置" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
              <StackPanel Margin="0,10"><TextBlock Text="{Binding Path}" FontSize="11" TextWrapping="Wrap" ToolTip="{Binding Path}" /><TextBlock Text="{Binding Evidence}" FontSize="10" Foreground="#91A087" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel>
            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTextColumn Header="大小 / 处理方式" Binding="{Binding SizeText}" Width="140" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="未发现可清理的残留" Foreground="#7A8D75" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Candidates.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding ActionHint}" TextWrapping="Wrap" FontSize="11" Foreground="#667D63" LineHeight="19" />
        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="10" Foreground="#929D8C" Margin="0,5,0,0" MaxHeight="42" ToolTip="{Binding Notes}" />
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
        <Button x:Name="DismissButton" Content="取消" IsCancel="True" MinWidth="88" Margin="0,0,10,0" Click="Dismiss_Click" />
        <Button x:Name="ConfirmButton" Content="确定" Style="{StaticResource Primary}" MinWidth="88" Click="Confirm_Click"><Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="White" /></DataTemplate></Button.ContentTemplate></Button>
      </StackPanel>
    </Grid>
  </Grid></Border>
</Window>
