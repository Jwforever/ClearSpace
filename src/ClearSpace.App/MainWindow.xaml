<Window x:Class="ClearSpace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClearSpace 清屿 · 软件管理与空间整理" Icon="/assets/ClearSpace.ico" Width="1260" Height="850"
        MinWidth="1160" MinHeight="720" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing" Activated="Window_Activated" Closed="Window_Closed">
  <Grid Background="#F7F8F5">
    <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#122D24">
      <Grid Margin="16,30,16,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="9,0,0,35">
          <StackPanel Orientation="Horizontal">
          <Border Width="35" Height="35" CornerRadius="11" Background="#B9DEAF" Margin="0,0,10,0" ClipToBounds="True">
            <Image Source="/assets/clearspace-mark.png" Stretch="Uniform" AutomationProperties.Name="清屿叶片图标" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="清屿" Foreground="#F2F7EF" FontWeight="SemiBold" FontSize="20" />
              <TextBlock Text="C L E A R S P A C E" Foreground="#8EA99A" FontSize="8" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="让电脑，轻一点。" Foreground="#7E9A89" FontSize="11" Margin="1,17,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="工 作 空 间" FontSize="10" Foreground="#628170" Margin="17,0,0,12" />
          <RadioButton x:Name="NavApps" Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="True" Tag="apps" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71D;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,14,0" /><TextBlock Text="软件管理" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavCleanup" Style="{StaticResource Nav}" GroupName="Navigation" Tag="cleanup" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,14,0" /><TextBlock Text="空间清理" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavLargeFiles" Style="{StaticResource Nav}" GroupName="Navigation" Tag="large" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,14,0" /><TextBlock Text="大文件清理" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavHistory" Style="{StaticResource Nav}" GroupName="Navigation" Tag="history" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,14,0" /><TextBlock Text="操作记录" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Border Background="#1A392D" CornerRadius="9" Padding="14" Margin="0,0,0,15">
            <StackPanel>
              <StackPanel Orientation="Horizontal"><Ellipse Fill="#A6D89B" Width="6" Height="6" Margin="0,0,7,0" /><TextBlock Text="本地运行 · 数据留在电脑" Foreground="#B0C9B7" FontSize="10" /></StackPanel>
              <TextBlock Text="每一次整理，都由你决定。" Foreground="#6F927D" FontSize="10" Margin="0,7,0,0" />
            </StackPanel>
          </Border>
          <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" GroupName="Navigation" Tag="about" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,14,0" /><TextBlock Text="关于清屿" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <TextBlock Text="PREVIEW  0.4.0" Foreground="#5E7C6B" FontSize="9" Margin="17,14,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="30,26,30,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,23">
        <StackPanel>
          <TextBlock Text="我的电脑   /   存储与应用" FontSize="11" Foreground="#8F9C94" Margin="0,0,0,13" />
          <TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PageDescription}" Style="{StaticResource MutedText}" Margin="1,9,0,0" />
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#EAF1E7" CornerRadius="12" Padding="10,5">
          <StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="#6C9C66" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="本地模式" FontSize="10" Foreground="#647B62" /></StackPanel>
        </Border>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="已安装应用" Style="{StaticResource MutedText}" />
            <StackPanel Orientation="Horizontal" Margin="0,11,0,5"><TextBlock Text="{Binding AppCount}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text=" 个" Foreground="#94A096" Margin="5,14,0,0" FontSize="11" /></StackPanel>
            <TextBlock Text="来自系统安装记录" FontSize="10" Foreground="#99A399" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="系统盘可用空间" Style="{StaticResource MutedText}" />
            <TextBlock Text="{Binding FreeSpace}" FontSize="28" FontWeight="SemiBold" Margin="0,11,0,5" />
          <ProgressBar x:Name="DiskUsageBar" Value="{Binding DiskUsedPercent, Mode=OneWay}" Maximum="100" Height="4" Background="#EDF1E9" Foreground="#A7BC94" BorderThickness="0" Margin="0,5,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Background="#EEF3E9" BorderBrush="#E0E8D9">
          <StackPanel>
            <TextBlock Foreground="#72816A" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="已扫描的可整理文件" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=NavLargeFiles}" Value="True"><Setter Property="Text" Value="本次发现的大文件" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <TextBlock Foreground="#426A43" FontSize="28" FontWeight="SemiBold" Margin="0,11,0,5"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding ScannedSize}" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=NavLargeFiles}" Value="True"><Setter Property="Text" Value="{Binding LargeFiles.TotalSizeText, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <TextBlock Foreground="#8D9C80" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding ScannedHint}" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=NavLargeFiles}" Value="True"><Setter Property="Text" Value="{Binding LargeFiles.TotalHint, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="2">
        <Grid x:Name="AppsPage">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="145" /><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#DFE6DF" BorderThickness="1" CornerRadius="7" Margin="0,0,12,0" Height="40">
              <Grid Margin="13,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="#9AA69B" VerticalAlignment="Center" />
                <TextBox x:Name="AppSearch" Grid.Column="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="0" FontSize="12" AutomationProperties.Name="搜索软件" />
                <TextBlock Grid.Column="1" Text="搜索软件名称、发布者…" Foreground="#A1ABA2" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=AppSearch}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
            <ComboBox x:Name="AppSort" Grid.Column="1" Margin="0,0,12,0" SelectedIndex="{Binding AppSortIndex, Mode=TwoWay}" VerticalContentAlignment="Center" Padding="8" FontSize="12" AutomationProperties.Name="软件排序">
              <ComboBoxItem Content="软件名称" /><ComboBoxItem Content="占用大小" /><ComboBoxItem Content="安装日期" /><ComboBoxItem Content="上次使用" /><ComboBoxItem Content="发布者" />
            </ComboBox>
            <ComboBox x:Name="AppSortDirection" Grid.Column="2" Margin="0,0,12,0" SelectedIndex="{Binding AppSortDirectionIndex, Mode=TwoWay}" VerticalContentAlignment="Center" Padding="8" FontSize="12" AutomationProperties.Name="排序方向"><ComboBoxItem Content="升序 ↑" /><ComboBoxItem Content="降序 ↓" /></ComboBox>
            <Button x:Name="RefreshAppsButton" Grid.Column="3" Content="刷新" Margin="0,0,9,0" Click="RefreshApps_Click" IsEnabled="{Binding CanAct}" />
            <Button x:Name="UninstallSelectedButton" Grid.Column="4" Content="{Binding UninstallLabel}" Style="{StaticResource Primary}" Click="UninstallSelected_Click" IsEnabled="{Binding CanUninstallSelected}" />
          </Grid>
          <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <DataGrid x:Name="AppsGrid" ItemsSource="{Binding AppsView}" IsReadOnly="True" CanUserSortColumns="False" AutomationProperties.Name="软件列表">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="44" CanUserSort="False">
                    <DataGridTemplateColumn.HeaderTemplate><DataTemplate><CheckBox x:Name="SelectAllApps" Click="SelectAllApps_Click" ToolTip="选择当前筛选结果" AutomationProperties.Name="全选软件" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanUninstall}" AutomationProperties.Name="选择软件" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="应用名称" Width="*" MinWidth="155" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="#EFF3EC" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Left"><TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold" Foreground="#6A8965" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding Version}" FontSize="10" Foreground="#9AA69C" Margin="0,4,0,0" /></StackPanel>
                      </Grid>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="120" SortMemberPath="Publisher"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#7A887C" /><Setter Property="ToolTip" Value="{Binding Publisher}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                  <DataGridTextColumn Header="占用 / 估算" Binding="{Binding SizeText}" Width="98" SortMemberPath="EstimatedBytes" />
                  <DataGridTextColumn Header="安装日期" Binding="{Binding InstallDate}" Width="105" />
                  <DataGridTextColumn x:Name="LastUsedColumn" Header="上次使用" Binding="{Binding LastUsedText}" Width="155" CanUserSort="False"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="ToolTip" Value="Windows 当前用户记录的最近启动时间；无记录不代表从未使用。请使用上方排序选项。" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                  <DataGridTemplateColumn Header="操作" Width="72" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="卸载" Padding="10,6" FontSize="11" Background="Transparent" BorderBrush="#E4EAE2" Click="UninstallOne_Click" Tag="{Binding}" IsEnabled="{Binding CanUninstall}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="{Binding AppsEmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#849083" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AppsView.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>
          <StackPanel Grid.Row="2" Margin="2,12,2,0"><Grid><TextBlock Text="{Binding AppListSummary}" FontSize="11" Foreground="#8C998D" /><TextBlock Text="占用大小由软件提供，可能不完整" FontSize="10" Foreground="#A0AA9F" HorizontalAlignment="Right" /></Grid><TextBlock Text="升序：从小到大、从旧到新；降序相反。无上次使用记录的应用始终置后。" FontSize="10" Foreground="#98A494" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel>
        </Grid>

        <Grid x:Name="CleanupPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ItemsControl ItemsSource="{Binding Categories}" IsEnabled="{Binding CanAct}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                  <CheckBox Content="{Binding Title}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Text="{Binding Description}" Foreground="#8C988C" FontSize="10" Margin="0,10,0,8" TextWrapping="Wrap" MinHeight="28" />
                  <TextBlock Text="{Binding Summary}" Foreground="#50805B" FontSize="12" />
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Grid.Row="1" Margin="0,17,0,12">
            <StackPanel VerticalAlignment="Center"><TextBlock Text="清理预览" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="仅扫描超过 7 天的文件；清理后可在系统回收站恢复。" FontSize="10" Foreground="#8B988B" Margin="0,5,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="ScanButton" Content="{Binding ScanLabel}" Click="Scan_Click" IsEnabled="{Binding CanAct}" Margin="0,0,9,0" />
              <Button x:Name="CleanButton" Content="{Binding CleanLabel}" Click="Clean_Click" Style="{StaticResource Primary}" IsEnabled="{Binding CanClean}" />
            </StackPanel>
          </Grid>
          <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <DataGrid x:Name="CleanupGrid" ItemsSource="{Binding Candidates}" IsReadOnly="True" RowHeight="56" AutomationProperties.Name="清理文件预览">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="44" CanUserSort="False">
                    <DataGridTemplateColumn.HeaderTemplate><DataTemplate><CheckBox IsChecked="True" Click="SelectAllFiles_Click" ToolTip="全选 / 取消选择文件" AutomationProperties.Name="全选清理文件" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="文件与位置" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Path}" FontSize="9" Foreground="#9AA59A" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="类别" Binding="{Binding CategoryTitle}" Width="115" />
                  <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="95" SortMemberPath="Length" />
                  <DataGridTextColumn Header="最后修改" Binding="{Binding ModifiedText}" Width="140" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Candidates.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9F5;" FontSize="31" Foreground="#B4C4AB" HorizontalAlignment="Center" Margin="0,0,0,15" />
                <TextBlock Text="{Binding CleanupEmptyText}" Foreground="#849080" HorizontalAlignment="Center" />
                <TextBlock Text="选择上方类别，查看可以整理的具体文件。" Foreground="#ACB4A8" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,0" />
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock Grid.Row="3" Text="{Binding CleanupSummary}" TextWrapping="Wrap" FontSize="10" Foreground="#8B988B" Margin="2,10,0,0" MaxHeight="44" />
        </Grid>

        <Grid x:Name="LargeFilesPage" Visibility="Collapsed" DataContext="{Binding LargeFiles, RelativeSource={RelativeSource AncestorType=Window}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,12" IsEnabled="{Binding CanAct}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
            <TextBox x:Name="LargeTargetPath" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="10,8" FontSize="12" BorderBrush="#DFE6DF" Margin="0,0,9,0" AutomationProperties.Name="大文件扫描位置" ToolTip="输入本地磁盘或文件夹的完整路径" />
            <Button x:Name="ChooseLargeFolderButton" Grid.Column="1" Content="选择文件夹" Click="ChooseLargeFolder_Click" Margin="0,0,9,0" />
            <Grid Grid.Column="2"><ComboBox x:Name="LargeDriveChoice" ItemsSource="{Binding Drives}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" Padding="8" VerticalContentAlignment="Center" AutomationProperties.Name="选择扫描磁盘" ToolTip="选择整块磁盘扫描" /><TextBlock Text="或选择磁盘…" Foreground="#84917E" FontSize="11" Margin="10,0,25,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedDrive}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          </Grid>
          <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="115" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="LargeMinimum" SelectedIndex="{Binding MinimumIndex, Mode=TwoWay}" IsEnabled="{Binding CanAct}" Padding="7" Margin="0,0,9,0" VerticalContentAlignment="Center" AutomationProperties.Name="最小文件大小"><ComboBoxItem Content="≥ 100 MB" /><ComboBoxItem Content="≥ 500 MB" /><ComboBoxItem Content="≥ 1 GB" /><ComboBoxItem Content="≥ 5 GB" /></ComboBox>
            <ComboBox x:Name="LargeType" Grid.Column="1" ItemsSource="{Binding Types}" SelectedIndex="{Binding TypeIndex, Mode=TwoWay}" Padding="7" Margin="0,0,9,0" VerticalContentAlignment="Center" AutomationProperties.Name="大文件类型筛选" />
            <Border Grid.Column="2" Background="White" BorderBrush="#DFE6DF" BorderThickness="1" CornerRadius="7" Margin="0,0,9,0"><Grid Margin="10,0"><TextBox x:Name="LargeSearch" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" FontSize="11" AutomationProperties.Name="搜索大文件" /><TextBlock Text="搜索文件名或路径…" Foreground="#A1ABA2" FontSize="11" IsHitTestVisible="False" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Query.Length}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
            <ComboBox x:Name="LargeSort" Grid.Column="3" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" Padding="7" Margin="0,0,9,0" VerticalContentAlignment="Center" AutomationProperties.Name="大文件排序"><ComboBoxItem Content="大小降序" /><ComboBoxItem Content="大小升序" /><ComboBoxItem Content="最新修改" /><ComboBoxItem Content="文件名称" /></ComboBox>
            <Button x:Name="ScanLargeFilesButton" Grid.Column="4" Content="开始扫描" Click="ScanLargeFiles_Click" IsEnabled="{Binding CanAct}" Margin="0,0,9,0" />
            <Button x:Name="CleanLargeFilesButton" Grid.Column="5" Content="{Binding CleanLabel}" Click="CleanLargeFiles_Click" Style="{StaticResource Primary}" IsEnabled="{Binding CanClean}" />
          </Grid>
          <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True"><Grid>
            <DataGrid x:Name="LargeFilesGrid" ItemsSource="{Binding View}" IsReadOnly="True" CanUserSortColumns="False" RowHeight="63" HorizontalScrollBarVisibility="Auto" SizeChanged="LargeFilesGrid_SizeChanged" AutomationProperties.Name="大文件扫描结果">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="44"><DataGridTemplateColumn.HeaderTemplate><DataTemplate><CheckBox IsChecked="{Binding DataContext.AllVisibleSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanAct, RelativeSource={RelativeSource AncestorType=DataGrid}}" ToolTip="全选 / 取消选择当前筛选结果" AutomationProperties.Name="全选可见大文件" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanAct, RelativeSource={RelativeSource AncestorType=DataGrid}}" AutomationProperties.Name="选择大文件" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="文件与完整位置" Width="*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding Path}" FontSize="10" Foreground="#98A391" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="115" />
                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90" />
                <DataGridTextColumn Header="最后修改" Binding="{Binding ModifiedText}" Width="145" />
                <DataGridTemplateColumn Header="操作" Width="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="定位" Padding="11,6" FontSize="11" Click="LocateLargeFile_Click" Tag="{Binding}" ToolTip="在资源管理器中选中此文件" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8B9A84" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding View.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </Grid></Border>
          <StackPanel Grid.Row="3" Margin="2,10,2,0"><Grid><TextBlock Text="{Binding SelectionText}" FontSize="11" Foreground="#7F9278" /><TextBlock Text="{Binding TotalText}" FontSize="10" Foreground="#98A38F" HorizontalAlignment="Right" /></Grid><TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#8E9C85" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="32" ToolTip="{Binding Summary}" /><TextBlock Text="仅列出文件，不会自动删除。系统和应用目录、链接、只读及脱机文件会跳过。" FontSize="10" Foreground="#9DA792" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel>
        </Grid>

        <Grid x:Name="HistoryPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,15"><TextBlock Text="最近的整理与卸载" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="打开记录文件夹" Click="OpenHistory_Click" HorizontalAlignment="Right" /></Grid>
          <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
            <Grid>
              <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding History}" IsReadOnly="True" RowHeight="76" AutomationProperties.Name="操作记录">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="110" />
                  <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="80" />
                  <DataGridTemplateColumn Header="操作详情" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#98A296" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Detail}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="结果" Binding="{Binding Status}" Width="125" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="还没有操作记录" Foreground="#849080" HorizontalAlignment="Center" /><TextBlock Text="完成一次整理后，记录会显示在这里。" FontSize="11" Foreground="#A3AD9E" Margin="0,9,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="少一点杂乱，多一点空间。" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="清屿 ClearSpace 0.4.0 · Windows 原生预览版" Foreground="#6C846B" />
                <TextBlock Text="一个本地运行的软件管理与空间整理工具。无需账号，应用本身不联网，不上传软件列表或文件路径。" TextWrapping="Wrap" Foreground="#83907D" Margin="0,15,0,0" LineHeight="23" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,15,0,0">
              <StackPanel>
                <TextBlock Text="当前版本的功能边界" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15" />
                <TextBlock Text="每个卸载器结束后自动刷新列表，并继续检查延迟变化。排序字段与升序/降序可独立选择，缺失记录始终置后。卸载完成后自动扫描并弹出残留清单，点击“确定”清理全部列出项，点击“取消”跳过。" TextWrapping="Wrap" LineHeight="25" Foreground="#7C8977" Margin="0,0,0,18" />
                <TextBlock Text="大文件清理支持选择本地固定磁盘或文件夹，按大小门槛扫描并筛选类型。大文件默认不勾选，确认后移入回收站；系统和应用目录、链接及脱机文件会跳过。下载、视频等个人文件夹仅在主动选择扫描位置后纳入此功能。" TextWrapping="Wrap" LineHeight="25" Foreground="#7C8977" Margin="0,0,0,18" />
                <TextBlock TextWrapping="Wrap" LineHeight="25" Foreground="#7C8977" Text="软件管理读取 HKLM / HKCU 的 32 位与 64 位安装记录，不包含 Microsoft Store 应用或未登记的便携软件。显示的大小由软件提供。&#x0a;&#x0a;卸载会启动软件原有的卸载程序。批量任务逐个执行，卸载窗口可能需要你继续操作。残留弹窗在卸载程序退出、安装记录移除后出现，只扫描卸载前记录的专属位置。文件移入回收站，产品专属注册表项先备份再删除；备份路径写入操作记录，恢复说明保存在备份目录。&#x0a;&#x0a;空间清理只扫描超过 7 天的用户临时文件、崩溃转储和 Chrome / Edge 缓存。浏览器运行时会跳过其缓存。清理逐个移入回收站，回收站清空后才释放磁盘空间；恢复请使用系统回收站。&#x0a;&#x0a;占用中、只读、系统文件和链接会被跳过。清理前会再次核对路径、大小和修改时间。不把下载、文档等个人目录作为清理根目录，不修改服务或系统注册信息，权限不足时跳过。" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,15,0,10">
              <Button Content="Windows 已安装应用" Click="WindowsApps_Click" Margin="0,0,10,0" />
              <Button Content="打开系统回收站" Click="OpenRecycleBin_Click" Margin="0,0,10,0" />
              <Button Content="打开记录文件夹" Click="OpenHistory_Click" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Row="3" Margin="0,19,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ProgressBar Height="2" IsIndeterminate="True" Foreground="#87B782" Background="#E7EDE2" Margin="0,0,0,10">
          <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
        </ProgressBar>
        <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="#8C9A88" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,105,0" />
        <Button Grid.Row="1" x:Name="CancelButton" Content="停止当前任务" Click="Cancel_Click" HorizontalAlignment="Right" Padding="8,4" FontSize="10">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
      </Grid>
    </Grid>
  </Grid>
</Window>
