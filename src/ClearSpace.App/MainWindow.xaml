<Window x:Class="ClearSpace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClearSpace 清屿 · 软件管理与空间整理" Icon="/assets/ClearSpace.ico" Width="1260" Height="850"
        MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Background="#F7F8F5">
    <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#122D24">
      <Grid Margin="16,30,16,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="9,0,0,35">
          <StackPanel Orientation="Horizontal">
          <Border Width="35" Height="35" CornerRadius="11" Background="#B9DEAF" Margin="0,0,10,0" ClipToBounds="True">
            <Image Source="/assets/clearspace-mark.png" Stretch="Uniform" AutomationProperties.Name="清屿叶片图标" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="清屿" Foreground="#F2F7EF" FontWeight="SemiBold" FontSize="20" />
              <TextBlock Text="C L E A R S P A C E" Foreground="#8EA99A" FontSize="8" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="让电脑，轻一点。" Foreground="#7E9A89" FontSize="11" Margin="1,17,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="工 作 空 间" FontSize="10" Foreground="#628170" Margin="17,0,0,12" />
          <RadioButton x:Name="NavApps" Style="{StaticResource Nav}" GroupName="Navigation" IsChecked="True" Tag="apps" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71D;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,14,0" /><TextBlock Text="软件管理" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavCleanup" Style="{StaticResource Nav}" GroupName="Navigation" Tag="cleanup" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,14,0" /><TextBlock Text="空间清理" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavHistory" Style="{StaticResource Nav}" GroupName="Navigation" Tag="history" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,14,0" /><TextBlock Text="操作记录" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Border Background="#1A392D" CornerRadius="9" Padding="14" Margin="0,0,0,15">
            <StackPanel>
              <StackPanel Orientation="Horizontal"><Ellipse Fill="#A6D89B" Width="6" Height="6" Margin="0,0,7,0" /><TextBlock Text="本地运行 · 数据留在电脑" Foreground="#B0C9B7" FontSize="10" /></StackPanel>
              <TextBlock Text="每一次整理，都由你决定。" Foreground="#6F927D" FontSize="10" Margin="0,7,0,0" />
            </StackPanel>
          </Border>
          <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" GroupName="Navigation" Tag="about" Checked="Navigate">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,2,14,0" /><TextBlock Text="关于清屿" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel>
          </RadioButton>
          <TextBlock Text="PREVIEW  0.1.1" Foreground="#5E7C6B" FontSize="9" Margin="17,14,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="30,26,30,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,23">
        <StackPanel>
          <TextBlock Text="我的电脑   /   存储与应用" FontSize="11" Foreground="#8F9C94" Margin="0,0,0,13" />
          <TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PageDescription}" Style="{StaticResource MutedText}" Margin="1,9,0,0" />
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#EAF1E7" CornerRadius="12" Padding="10,5">
          <StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="#6C9C66" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="本地模式" FontSize="10" Foreground="#647B62" /></StackPanel>
        </Border>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="已安装应用" Style="{StaticResource MutedText}" />
            <StackPanel Orientation="Horizontal" Margin="0,11,0,5"><TextBlock Text="{Binding AppCount}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text=" 个" Foreground="#94A096" Margin="5,14,0,0" FontSize="11" /></StackPanel>
            <TextBlock Text="来自系统安装记录" FontSize="10" Foreground="#99A399" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="系统盘可用空间" Style="{StaticResource MutedText}" />
            <TextBlock Text="{Binding FreeSpace}" FontSize="28" FontWeight="SemiBold" Margin="0,11,0,5" />
          <ProgressBar x:Name="DiskUsageBar" Value="{Binding DiskUsedPercent, Mode=OneWay}" Maximum="100" Height="4" Background="#EDF1E9" Foreground="#A7BC94" BorderThickness="0" Margin="0,5,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Background="#EEF3E9" BorderBrush="#E0E8D9">
          <StackPanel>
            <TextBlock Text="已扫描的可整理文件" Foreground="#72816A" FontSize="12" />
            <TextBlock Text="{Binding ScannedSize}" Foreground="#426A43" FontSize="28" FontWeight="SemiBold" Margin="0,11,0,5" />
            <TextBlock Text="{Binding ScannedHint}" Foreground="#8D9C80" FontSize="10" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="2">
        <Grid x:Name="AppsPage">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="145" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#DFE6DF" BorderThickness="1" CornerRadius="7" Margin="0,0,12,0" Height="40">
              <Grid Margin="13,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="#9AA69B" VerticalAlignment="Center" />
                <TextBox x:Name="AppSearch" Grid.Column="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="0" FontSize="12" AutomationProperties.Name="搜索软件" />
                <TextBlock Grid.Column="1" Text="搜索软件名称、发布者…" Foreground="#A1ABA2" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=AppSearch}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
            <ComboBox x:Name="AppSort" Grid.Column="1" Margin="0,0,12,0" SelectedIndex="0" SelectionChanged="SortChanged" VerticalContentAlignment="Center" Padding="8" FontSize="12" AutomationProperties.Name="软件排序">
              <ComboBoxItem Content="按名称排序" /><ComboBoxItem Content="按占用大小" /><ComboBoxItem Content="按安装日期" />
            </ComboBox>
            <Button x:Name="RefreshAppsButton" Grid.Column="2" Content="刷新" Margin="0,0,9,0" Click="RefreshApps_Click" IsEnabled="{Binding CanAct}" />
            <Button x:Name="UninstallSelectedButton" Grid.Column="3" Content="{Binding UninstallLabel}" Style="{StaticResource Primary}" Click="UninstallSelected_Click" IsEnabled="{Binding CanUninstallSelected}" />
          </Grid>
          <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <DataGrid x:Name="AppsGrid" ItemsSource="{Binding AppsView}" IsReadOnly="True" AutomationProperties.Name="软件列表">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="44" CanUserSort="False">
                    <DataGridTemplateColumn.HeaderTemplate><DataTemplate><CheckBox x:Name="SelectAllApps" Click="SelectAllApps_Click" ToolTip="选择当前筛选结果" AutomationProperties.Name="全选软件" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanUninstall}" AutomationProperties.Name="选择软件" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="应用名称" Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="#EFF3EC" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Left"><TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold" Foreground="#6A8965" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding Version}" FontSize="10" Foreground="#9AA69C" Margin="0,4,0,0" /></StackPanel>
                      </Grid>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="150" SortMemberPath="Publisher"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#7A887C" /><Setter Property="ToolTip" Value="{Binding Publisher}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                  <DataGridTextColumn Header="占用 / 估算" Binding="{Binding SizeText}" Width="103" SortMemberPath="EstimatedBytes" />
                  <DataGridTextColumn Header="安装日期" Binding="{Binding InstallDate}" Width="105" />
                  <DataGridTemplateColumn Header="操作" Width="80" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="卸载" Padding="10,6" FontSize="11" Background="Transparent" BorderBrush="#E4EAE2" Click="UninstallOne_Click" Tag="{Binding}" IsEnabled="{Binding CanUninstall}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="{Binding AppsEmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#849083" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding AppsView.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>
          <Grid Grid.Row="2" Margin="2,12,2,0"><TextBlock Text="{Binding AppListSummary}" FontSize="11" Foreground="#8C998D" /><TextBlock Text="占用大小由软件提供，可能不完整" FontSize="10" Foreground="#A0AA9F" HorizontalAlignment="Right" /></Grid>
        </Grid>

        <Grid x:Name="CleanupPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ItemsControl ItemsSource="{Binding Categories}" IsEnabled="{Binding CanAct}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                  <CheckBox Content="{Binding Title}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Text="{Binding Description}" Foreground="#8C988C" FontSize="10" Margin="0,10,0,8" TextWrapping="Wrap" MinHeight="28" />
                  <TextBlock Text="{Binding Summary}" Foreground="#50805B" FontSize="12" />
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Grid.Row="1" Margin="0,17,0,12">
            <StackPanel VerticalAlignment="Center"><TextBlock Text="清理预览" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="仅扫描超过 7 天的文件；清理后可在系统回收站恢复。" FontSize="10" Foreground="#8B988B" Margin="0,5,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="ScanButton" Content="{Binding ScanLabel}" Click="Scan_Click" IsEnabled="{Binding CanAct}" Margin="0,0,9,0" />
              <Button x:Name="CleanButton" Content="{Binding CleanLabel}" Click="Clean_Click" Style="{StaticResource Primary}" IsEnabled="{Binding CanClean}" />
            </StackPanel>
          </Grid>
          <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <DataGrid x:Name="CleanupGrid" ItemsSource="{Binding Candidates}" IsReadOnly="True" RowHeight="56" AutomationProperties.Name="清理文件预览">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="44" CanUserSort="False">
                    <DataGridTemplateColumn.HeaderTemplate><DataTemplate><CheckBox IsChecked="True" Click="SelectAllFiles_Click" ToolTip="全选 / 取消选择文件" AutomationProperties.Name="全选清理文件" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="文件与位置" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Path}" FontSize="9" Foreground="#9AA59A" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="类别" Binding="{Binding CategoryTitle}" Width="115" />
                  <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="95" SortMemberPath="Length" />
                  <DataGridTextColumn Header="最后修改" Binding="{Binding ModifiedText}" Width="140" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Candidates.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9F5;" FontSize="31" Foreground="#B4C4AB" HorizontalAlignment="Center" Margin="0,0,0,15" />
                <TextBlock Text="{Binding CleanupEmptyText}" Foreground="#849080" HorizontalAlignment="Center" />
                <TextBlock Text="选择上方类别，查看可以整理的具体文件。" Foreground="#ACB4A8" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,0" />
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock Grid.Row="3" Text="{Binding CleanupSummary}" TextWrapping="Wrap" FontSize="10" Foreground="#8B988B" Margin="2,10,0,0" MaxHeight="44" />
        </Grid>

        <Grid x:Name="HistoryPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,15"><TextBlock Text="最近的整理与卸载" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="打开记录文件夹" Click="OpenHistory_Click" HorizontalAlignment="Right" /></Grid>
          <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
            <Grid>
              <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding History}" IsReadOnly="True" RowHeight="76" AutomationProperties.Name="操作记录">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="110" />
                  <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="80" />
                  <DataGridTemplateColumn Header="操作详情" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#98A296" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Detail}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="结果" Binding="{Binding Status}" Width="125" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="还没有操作记录" Foreground="#849080" HorizontalAlignment="Center" /><TextBlock Text="完成一次整理后，记录会显示在这里。" FontSize="11" Foreground="#A3AD9E" Margin="0,9,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="少一点杂乱，多一点空间。" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="清屿 ClearSpace 0.1.1 · Windows 原生预览版" Foreground="#6C846B" />
                <TextBlock Text="一个本地运行的软件管理与空间整理工具。无需账号，应用本身不联网，不上传软件列表或文件路径。" TextWrapping="Wrap" Foreground="#83907D" Margin="0,15,0,0" LineHeight="23" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,15,0,0">
              <StackPanel>
                <TextBlock Text="当前版本的功能边界" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15" />
                <TextBlock TextWrapping="Wrap" LineHeight="25" Foreground="#7C8977" Text="软件管理读取 HKLM / HKCU 的 32 位与 64 位安装记录，不包含 Microsoft Store 应用或未登记的便携软件。显示的大小由软件提供。&#x0a;&#x0a;卸载会启动软件原有的卸载程序。批量任务逐个执行，卸载窗口可能需要你继续操作；部分启动器会提前退出，可刷新列表核对结果。首版不自动删除软件残留。&#x0a;&#x0a;空间清理只扫描超过 7 天的用户临时文件、崩溃转储和 Chrome / Edge 缓存。浏览器运行时会跳过其缓存。清理逐个移入回收站，回收站清空后才释放磁盘空间；恢复请使用系统回收站。&#x0a;&#x0a;占用中、只读、系统文件和链接会被跳过。清理前会再次核对路径、大小和修改时间。不会扫描下载、文档等个人目录。" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,15,0,10">
              <Button Content="Windows 已安装应用" Click="WindowsApps_Click" Margin="0,0,10,0" />
              <Button Content="打开系统回收站" Click="OpenRecycleBin_Click" Margin="0,0,10,0" />
              <Button Content="打开记录文件夹" Click="OpenHistory_Click" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Row="3" Margin="0,19,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ProgressBar Height="2" IsIndeterminate="True" Foreground="#87B782" Background="#E7EDE2" Margin="0,0,0,10">
          <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
        </ProgressBar>
        <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="#8C9A88" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,105,0" />
        <Button Grid.Row="1" x:Name="CancelButton" Content="停止当前任务" Click="Cancel_Click" HorizontalAlignment="Right" Padding="8,4" FontSize="10">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
      </Grid>
    </Grid>
  </Grid>
</Window>
